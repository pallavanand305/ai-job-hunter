# ---- Core ----
DATABASE_URL=sqlite:///./data/jobhunter.db
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ---- LLM (primary -> secondary -> template fallback) ----
# Gemini free tier: https://aistudio.google.com/app/apikey
# New projects should use 3.5 Flash-Lite; 2.5 Flash is legacy and routes there on 2026-12-01.
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Groq free tier (OpenAI-compatible, JSON mode): https://console.groq.com/keys
# Llama 3.3 70B is Enterprise-only; GPT-OSS is available on the free plan.
LLM_SECONDARY_PROVIDER=groq
LLM_SECONDARY_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional later: OpenRouter / local Ollama
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_ALLOW_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Legacy compatibility (leave auto)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Reliability / free-tier safety
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=1
LLM_BACKOFF_SECONDS=2
LLM_MAX_RETRY_WAIT_SECONDS=5
LLM_MIN_INTERVAL_SECONDS=3
LLM_DAILY_CALL_LIMIT=200
LLM_CACHE_ENABLED=true

# Tailoring match-report target. 90 means the report flags any remaining verified gaps.
TAILOR_TARGET_SCORE=90

# ---- Scheduler ----
SCHEDULER_ENABLED=true
DISCOVERY_HOUR=9
DISCOVERY_MINUTE=0
MATCH_INTERVAL_MINUTES=120
GMAIL_SYNC_MINUTES=60
TIMEZONE=Asia/Kolkata

# ---- Profile defaults (used on first run) ----
DEFAULT_USER_NAME=Pallav Anand
DEFAULT_USER_EMAIL=pallavanand757@gmail.com
DEFAULT_USER_LOCATION=Noida, India
DEFAULT_ROLES=AI Engineer,Python Backend Engineer,MLOps Engineer,DevOps Engineer,GenAI Engineer,Cloud Engineer,Software Engineer
DEFAULT_REMOTE_OK=true
DEFAULT_MIN_SALARY=0
DEFAULT_CURRENCY=INR

# ---- Job platforms (optional) ----
# Adzuna free API keys: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Jooble free API key: https://jooble.org/api/about
JOOBLE_API_KEY=
# Permitted job-alert RSS/Atom feeds. LinkedIn/Naukri/Indeed/Instahyre/Wellfound
# have no open apply APIs; alerts are ingested from feeds and applied manually.
LINKEDIN_FEED_URL=
NAUKRI_FEED_URL=
INDEED_FEED_URL=
INSTAHYRE_FEED_URL=
WELLFOUND_FEED_URL=

# ---- Gmail (optional) ----
GOOGLE_CLIENT_SECRETS=data/google_credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json
GMAIL_QUERY=newer_than:30d (interview OR application OR recruiter OR assessment OR offer)

# ---- Safety ----
REQUIRE_APPROVAL=true
